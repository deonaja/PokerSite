# Vercel Postgres connection string (auto-injected pas connect di Vercel dashboard)
# Local dev: copy dari Vercel project settings → Storage → .env.local tab
DATABASE_URL="postgres://..."

# Admin secret key. Generate dengan: openssl rand -hex 16
# Akses admin via /admin?key=<value>
ADMIN_KEY="ganti-dengan-random-32-char-string"
