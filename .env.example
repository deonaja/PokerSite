# Neon PostgreSQL connection string (direct connection, no pooler required)
# Get from: https://console.neon.tech → project → connection string
DATABASE_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# Also required by @vercel/postgres createClient (used for transactions)
POSTGRES_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# Admin secret key — protect this, don't share with players
# Generate: openssl rand -hex 16
# Access via: /admin?key=<ADMIN_KEY>
ADMIN_KEY="ganti-dengan-random-key"
