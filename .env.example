# Neon PostgreSQL connection string (direct connection, no pooler required)
# Get from: https://console.neon.tech → project → connection string
DATABASE_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# Also required by @vercel/postgres createClient (used for transactions)
POSTGRES_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# Admin secret key — protect this, don't share with players
# Generate: openssl rand -hex 16
# Access via: /admin?key=<ADMIN_KEY>
ADMIN_KEY="ganti-dengan-random-key"

# Web Push (VAPID) — generate once with `pnpm gen:vapid`, then paste here.
# Public key is exposed to the browser; private key is a secret (never commit).
# Without these, push notifications are simply disabled (the app still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional — isolated DB for `pnpm test` (e.g. a Neon branch of the dev DB).
# When set, the Playwright suite uses THIS connection (overriding DATABASE_URL /
# POSTGRES_URL) so tests never mutate the real dev data. Leave blank to run
# against DATABASE_URL (not isolated). Create a branch in the Neon console
# (Branches → New Branch) and paste its connection string here.
TEST_DATABASE_URL=""
